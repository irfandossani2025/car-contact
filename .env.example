APP_NAME="Contact Scan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Contact Scan ----
# Web push keys: run `php artisan contactscan:vapid` and paste the output here
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Telegram bot (free): create with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string
TELEGRAM_WEBHOOK_SECRET=

# BulkSMS (paid per SMS). Use Token ID + Token Secret (or BULKSMS_BASIC_AUTH instead)
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
BULKSMS_BASIC_AUTH=
# Optional sender ID (must be approved in your BulkSMS account). Leave blank for default.
BULKSMS_FROM=
# Country code added when an owner types a local number, e.g. 971. Leave blank to require +country code.
CS_SMS_DEFAULT_COUNTRY_CODE=
CS_SMS_DAILY_LIMIT=10

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Business number in international format, e.g. +97150xxxxxxx
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=car_alert
WHATSAPP_TEMPLATE_LANG=en
CS_WHATSAPP_DAILY_LIMIT=10

# Cloudflare Turnstile (free bot check). Leave blank to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

CS_VEHICLE_COOLDOWN=120
CS_SENDER_HOURLY_LIMIT=6
